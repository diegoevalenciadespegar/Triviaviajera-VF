{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    { "source": "/(.*).json", "headers": [{ "key": "Content-Type", "value": "application/json" }] },
    { "source": "/(.*).png", "headers": [{ "key": "Content-Type", "value": "image/png" }] }
  ]
}
